{
    "name": "clarkwinkelmann/flarum-ext-post-bookmarks",
    "description": "Bookmark posts to find them easily later",
    "keywords": [
        "flarum",
        "bookmark"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0-beta",
        "php": ">=8.3"
    },
    "authors": [
        {
            "name": "Clark Winkelmann",
            "homepage": "https://clarkwinkelmann.com/",
            "email": "clark.winkelmann@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/clarkwinkelmann/flarum-ext-post-bookmarks",
        "forum": "https://discuss.flarum.org/d/27698"
    },
    "autoload": {
        "psr-4": {
            "ClarkWinkelmann\\PostBookmarks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClarkWinkelmann\\PostBookmarks\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "flarum-extension": {
            "title": "Post Bookmarks",
            "category": "feature",
            "icon": {
                "name": "fas fa-bookmark",
                "backgroundColor": "#684ba6",
                "color": "#fff"
            }
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/27698"
        }
    }
}
